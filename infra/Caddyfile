# Plain HTTP behind the Cloudflare Tunnel (D122): Cloudflare terminates TLS and cloudflared sends
# every host here. No access log: telemetry carries no reader data (D137).
{
	auto_https off
	admin off
	# Caddy's own log (errors, such as an upstream that is down) names the request: its headers carry
	# the Access JWT, an address and a user agent, and its URI a query string. None are logged.
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>uri regexp \?.*$ ""
			}
		}
	}
}

# Trace context is the platform's own: a reader cannot pick a trace, keep requests out of traces or
# plant text that is stored with jobs and sent on (D155).
(no_trace_headers) {
	request_header -traceparent
	request_header -tracestate
	request_header -baggage
}

# Grafana in the lgtm container, behind Access (D123, D139).
http://ops.{$ANR_ROOT_DOMAIN} {
	import no_trace_headers
	reverse_proxy lgtm:3000
}

# The desk, behind Access; its pages call the API at /api/* (the prefix is stripped).
http://desk.{$ANR_ROOT_DOMAIN} {
	import no_trace_headers
	handle_path /api/* {
		reverse_proxy api:8787
	}
	handle {
		reverse_proxy web:4321
	}
}

# The API for a person's own agent (D191): outside Access, so a client without a browser can reach
# it; the API answers 401 to anything but a valid personal token or Access JWT. Only the desk's
# routes, the MCP server and the contract are served here.
http://api.{$ANR_ROOT_DOMAIN} {
	import no_trace_headers
	@agent path /desk/* /mcp /mcp/* /openapi.yaml /healthz
	handle @agent {
		reverse_proxy api:8787
	}
	handle {
		respond 404
	}
}

# The root and every newsroom's site. Reader sites reach the API only server-side, from the web app.
:80 {
	import no_trace_headers
	reverse_proxy web:4321
}
