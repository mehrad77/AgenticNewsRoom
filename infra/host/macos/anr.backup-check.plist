<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- WAL archiving check every 30 minutes (D131). install.sh fills in the repo and home paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>anr.backup-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ANR_DIR__/infra/backup/backup.sh</string>
    <string>check</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ANR_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's PATH lacks Docker Desktop's and Homebrew's. -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/anr/backup-check.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/anr/backup-check.log</string>
</dict>
</plist>
