<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly full backup, Sunday 03:00 (D51, D131). A run missed while the Mac slept runs once when it wakes. install.sh fills in the repo and home paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>anr.backup-full</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ANR_DIR__/infra/backup/backup.sh</string>
    <string>full</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ANR_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's PATH lacks Docker Desktop's and Homebrew's. -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/anr/backup-full.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/anr/backup-full.log</string>
</dict>
</plist>
