# Deployment settings (not secret)

# Newsrooms at <subdomain>.$ANR_ROOT_DOMAIN, the editor's desk at desk.$ANR_ROOT_DOMAIN
ANR_ROOT_DOMAIN=localhost
# Cloudflare Access team domain and application audience tag guarding the desk
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Dev: host port for Postgres (change it if 5432 is taken; update the URLs below to match)
ANR_PG_PORT=5432
# Production only (infra/AGENTS.md): WAL archiving to R2 on, and no integration-test database.
# ANR_WAL_ARCHIVE=on
# ANR_DATABASES=anr
# R2 bucket for pgBackRest (keys below); the endpoint defaults to the R2 account's.
ANR_BACKUP_BUCKET=
# Optional: where config/ lives (defaults to ../../config from an app's directory)
# ANR_CONFIG_DIR=

# Secrets: the complete list. Channel credentials live encrypted in Postgres, never here.

# Encrypts channel credentials in Postgres: `openssl rand -base64 32`. Not in any backup, so keep
# a copy outside the VM: without it, restored channel credentials cannot be read.
ANR_PLATFORM_KEY=
# Postgres passwords: the superuser and the three platform roles. Dev values below; in
# production generate each with `openssl rand -hex 32` (hex keeps the database URLs valid).
POSTGRES_PASSWORD=postgres
ANR_MIGRATOR_DB_PASSWORD=anr_migrator
ANR_APP_DB_PASSWORD=anr_app
ANR_SYSTEM_DB_PASSWORD=anr_system
# Database URLs for apps run on the host (`pnpm dev`, tests). The Compose prod profile builds
# them from the passwords above with host `postgres` and ignores these.
DATABASE_URL=postgres://anr_app:anr_app@localhost:5432/anr
# dbmate (Go lib/pq) defaults to sslmode=require; Postgres is only reachable locally, without TLS.
DATABASE_MIGRATION_URL=postgres://anr_migrator:anr_migrator@localhost:5432/anr?sslmode=disable
DATABASE_SYSTEM_URL=postgres://anr_system:anr_system@localhost:5432/anr
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encrypts backups in R2 (pgBackRest). Keep a copy outside the VM: without it no backup restores.
ANR_BACKUP_PASSPHRASE=
GEMINI_API_KEY=
# Caddy DNS-01 for the wildcard certificate (production only)
CLOUDFLARE_DNS_API_TOKEN=
