# Deployment settings (not secret)

# Newsrooms at <subdomain>.$ANR_ROOT_DOMAIN, the editor's desk at desk.$ANR_ROOT_DOMAIN
ANR_ROOT_DOMAIN=localhost
# Cloudflare Access team domain and application audience tag guarding the desk
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Dev only, with both CF_ACCESS_* empty and ANR_ROOT_DOMAIN=localhost: the desk signs you in as this
# email; deploy refuses it (D95)
# ANR_DESK_DEV_EMAIL=
# Where the desk files a sample miss as an issue (not a secret; default: the ANR repository) (D102)
# ANR_ISSUES_URL=https://github.com/mehrad77/AgenticNewsRoom/issues/new
# Host port for Postgres on loopback: dev 5432, prod 5433 (D126); change it if taken (dev: update
# the URLs below to match).
ANR_PG_PORT=5432
# Sends to external channels (Telegram) only when `live`; anything else records each send as a dry
# run (D126). Production only; deploy requires it.
# ANR_PUBLISH=live
# Production only: where the release images are (ghcr.io/<owner>, D134). ANR_VERSION, the tag, is
# set by `infra/deploy.sh <tag>`.
# ANR_IMAGES=ghcr.io/mehrad77
# Production, milestone 7b: the operator's own Telegram chat for Grafana's alerts (D140).
# ANR_OPS_TELEGRAM_CHAT_ID=
# Production only (infra/AGENTS.md): WAL archiving to R2 on, and no integration-test database.
# ANR_WAL_ARCHIVE=on
# ANR_DATABASES=anr
# R2 buckets (keys below): pgBackRest's, raw pages (D55), and episode audio, published images and
# the TTS cache (D132). Without ANR_RAW_BUCKET or ANR_MEDIA_BUCKET, a local directory is used.
ANR_BACKUP_BUCKET=
# ANR_RAW_BUCKET=
# ANR_MEDIA_BUCKET=
# An S3 endpoint other than the R2 account's, for a local stand-in (raw and media buckets).
# ANR_S3_ENDPOINT=
# The ingestion service, for the agents worker's jobs (internal; Compose uses http://ingestion:8000)
ANR_INGESTION_URL=http://127.0.0.1:8101
# The verifier service the gate calls for its code checks.
ANR_VERIFIER_URL=http://127.0.0.1:8102
# Summariser model calls per minute from the agents worker; keep it under your API key's limit
# (Google AI Studio shows the free tier's)
ANR_SUMMARISER_RPM=10
# Raw pages and images as fetched (ingestion writes; the publisher reads source images) when
# ANR_RAW_BUCKET is not set (default <repo>/.data/raw).
# ANR_RAW_DIR=
# Optional: where config/ lives (defaults to ../../config from an app's directory)
# ANR_CONFIG_DIR=
# Models file: empty = config/models.yaml; free = config/models.free.yaml, free tiers that fall
# back on each other (development only; deploy refuses it). Keys: docs/development.md#free-models
ANR_MODELS=

# Episode audio (D109): where files and the TTS cache are kept when ANR_MEDIA_BUCKET is not set,
# and `ANR_TTS=fake` to voice episodes with tones in dry runs (no TTS calls).
ANR_MEDIA_DIR=
ANR_TTS=
# The c2patool binary that signs episodes and images (D25, D120), when it is not on the PATH.
ANR_C2PATOOL=
# The exiftool binary that writes images' Photo Metadata (D120), when it is not on the PATH.
ANR_EXIFTOOL=

# Secrets: the complete list. Channel credentials live encrypted in Postgres, never here.

# Encrypts channel credentials in Postgres: `openssl rand -base64 32`. Not in any backup, so keep
# a copy outside the VM: without it, restored channel credentials cannot be read.
ANR_PLATFORM_KEY=
# Postgres passwords: the superuser and the three platform roles. Dev values below; in
# production generate each with `openssl rand -hex 32` (hex keeps the database URLs valid).
POSTGRES_PASSWORD=postgres
ANR_MIGRATOR_DB_PASSWORD=anr_migrator
ANR_APP_DB_PASSWORD=anr_app
ANR_SYSTEM_DB_PASSWORD=anr_system
# Database URLs for apps run on the host (`pnpm dev`, tests). The Compose prod profile builds
# them from the passwords above with host `postgres` and ignores these.
DATABASE_URL=postgres://anr_app:anr_app@localhost:5432/anr
# dbmate (Go lib/pq) defaults to sslmode=require; Postgres is only reachable locally, without TLS.
DATABASE_MIGRATION_URL=postgres://anr_migrator:anr_migrator@localhost:5432/anr?sslmode=disable
DATABASE_SYSTEM_URL=postgres://anr_system:anr_system@localhost:5432/anr
R2_ACCOUNT_ID=
# R2 tokens: the apps' (raw and media buckets) and pgBackRest's (the backups bucket only).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Encrypts backups in R2 (pgBackRest): `openssl rand -base64 48`. Keep a copy outside the server:
# without it no backup restores.
ANR_BACKUP_PASSPHRASE=
GEMINI_API_KEY=
# Free-tier model keys for ANR_MODELS=free; a provider without a key is skipped.
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
# Production: the Cloudflare Tunnel's connector token (`infra/terraform/tf.sh output -raw
# tunnel_token`, D122).
CLOUDFLARE_TUNNEL_TOKEN=
# Production, milestone 7b: the ops bot Grafana alerts through; not a newsroom Channel (D140).
ANR_OPS_TELEGRAM_BOT_TOKEN=
