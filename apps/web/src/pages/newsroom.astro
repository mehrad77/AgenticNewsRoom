---
// Every page of a newsroom site; src/lib/page.ts decides what it shows.
import Base from "../layouts/Base.astro";
import "../styles/site.css";
import { directionOf, pageUrl } from "@anr/core";
import { challengeForm, sendChallenge } from "../lib/challenge.ts";
import { db } from "../lib/db.ts";
import { scriptJson } from "../lib/metadata.ts";
import { loadPage } from "../lib/page.ts";
import { imageResponse, mediaRoute, publishedImage } from "../lib/media.ts";
import { audioResponse, countDownload, episodeAudio, feedRenderer, podcastFeed, readerAddress, podcastRoute } from "../lib/podcast.ts";
import { newsroomBySubdomain } from "../lib/reader.ts";
import { route } from "../lib/routes.ts";

const site = Astro.locals.site;
if (site.kind !== "newsroom") return new Response("Unknown site", { status: 404 });
const rootDomain = process.env.ANR_ROOT_DOMAIN ?? "localhost";
// The podcast feed and the counting audio redirect (src/lib/podcast.ts).
const pod = podcastRoute(site.path);
if (pod) {
  const newsroom = await newsroomBySubdomain(db(), site.newsroom.subdomain);
  if (!newsroom) return new Response("Unknown site", { status: 404 });
  if (pod.kind === "audio") {
    const key = await episodeAudio(db(), newsroom, pod.publicationId);
    if (!key) return new Response("Not found", { status: 404 });
    const headers = Astro.request.headers;
    const listener = readerAddress(headers.get("cf-connecting-ip"), Astro.clientAddress);
    await countDownload(db(), newsroom, pod.publicationId, listener, headers.get("user-agent"));
    // Counted above, before the redirect into the bucket (D110, D132).
    return await audioResponse(key, headers.get("range"));
  }
  const address = {
    subdomain: newsroom.subdomain,
    rootDomain,
    languages: newsroom.languages,
    devPort: rootDomain === "localhost" ? Number(Astro.url.port) || undefined : undefined,
  };
  const label = await feedRenderer().disclosureLabel(site.language);
  const feed = await podcastFeed(db(), newsroom, site.language, pod.series, address, label);
  if (!feed) return new Response("Not found", { status: 404 });
  return new Response(feed, { headers: { "content-type": "application/rss+xml; charset=utf-8" } });
}
// A published image with its metadata and manifest (src/lib/media.ts).
const imageId = mediaRoute(site.path);
if (imageId) {
  const newsroom = await newsroomBySubdomain(db(), site.newsroom.subdomain);
  const image = newsroom && (await publishedImage(db(), newsroom, imageId));
  return image ? await imageResponse(image) : new Response("Not found", { status: 404 });
}
// A reader's challenge from the form under a piece (D114): passed to the API, then on to the
// reader's status page. Handled before the page loads, so it is not counted as a view.
let challengeFailed = false;
if (Astro.request.method === "POST" && route(site.path).kind === "publication") {
  const form = await Astro.request.formData();
  const body = challengeForm(form);
  if (!body) return Astro.redirect(Astro.url.pathname, 303);
  const headers = Astro.request.headers;
  const sent = await sendChallenge(
    process.env.ANR_API_URL ?? "http://127.0.0.1:8787",
    site.newsroom.slug,
    String(form.get("publication") ?? ""),
    body,
    {
      address: readerAddress(headers.get("cf-connecting-ip"), Astro.clientAddress),
      userAgent: headers.get("user-agent") ?? "",
    },
  );
  if (sent.ok) {
    const address = {
      subdomain: site.newsroom.subdomain,
      rootDomain,
      languages: site.newsroom.languages,
      devPort: rootDomain === "localhost" ? Number(Astro.url.port) || undefined : undefined,
    };
    const status = `${pageUrl(address, site.language, `/challenge/${sent.id}`)}?k=${encodeURIComponent(sent.token)}`;
    return Astro.redirect(status, 303);
  }
  challengeFailed = true;
  Astro.response.status = sent.status === 429 || sent.status === 400 ? sent.status : 503;
}
const page = await loadPage(
  { pool: db(), rootDomain, devPort: rootDomain === "localhost" ? Number(Astro.url.port) || undefined : undefined },
  {
    subdomain: site.newsroom.subdomain,
    language: site.language,
    path: site.path,
    query: Astro.url.searchParams,
    userAgent: Astro.request.headers.get("user-agent"),
  },
);
if (page.kind === "unknown") return new Response("Unknown site", { status: 404 });
if (page.kind === "ninjs")
  return new Response(JSON.stringify(page.json, null, 2), {
    headers: { "content-type": "application/json; charset=utf-8" },
  });
if (page.kind === "not-found") Astro.response.status = 404;
// A reader's status page is theirs: never indexed, and its token never sent on as a referrer.
if (page.kind === "challenge") {
  Astro.response.headers.set("x-robots-tag", "noindex");
  Astro.response.headers.set("referrer-policy", "no-referrer");
}
const name = page.newsroom.name[page.language] ?? page.newsroom.slug;
const w = page.words;
const date = (d: Date) =>
  new Intl.DateTimeFormat(page.language, { dateStyle: "long", timeZone: page.newsroom.timezone }).format(d);
---
<Base title={page.title} language={page.language} direction={directionOf(page.language)}>
  <Fragment slot="head">
    {page.kind === "publication" && (
      <>
        <link rel="canonical" href={page.jsonLd.url as string} />
        <link rel="alternate" type="application/json" href={page.ninjsUrl} />
        <meta name="iptc:digitalSourceType" content={page.digitalSourceType} />
        <script type="application/ld+json" set:html={scriptJson(page.jsonLd)} />
      </>
    )}
  </Fragment>
  <header>
    <strong><a href={page.links.home}>{name}</a></strong>
    <form action={page.links.search} method="get" role="search">
      <input type="search" name="q" placeholder={w.searchPlaceholder} value={page.kind === "search" ? page.query : ""} />
    </form>
    {page.languages.length > 1 && (
      <nav>
        {page.languages.filter((l) => l.language !== page.language).map((l) => (
          <a href={l.url} hreflang={l.language} lang={l.language}>{l.language}</a>
        ))}
      </nav>
    )}
  </header>
  <main>
    {page.kind === "publication" && (
      <>
        {page.publication.status === "corrected" && <p><a href={page.links.corrections}>{w.corrected}</a></p>}
        <p><time datetime={page.publication.publishedAt.toISOString()}>{date(page.publication.publishedAt)}</time></p>
        <Fragment set:html={page.bodyHtml} />
        {page.publication.corrections.map((c) => (
          <aside id={c.id}><strong>{w.corrected}</strong> ({date(c.publishedAt)}): {c.notice}</aside>
        ))}
        <section id="challenge">
          <h2>{w.challenge.heading}</h2>
          <p>{w.challenge.intro}</p>
          {challengeFailed && <p role="alert">{w.challenge.failed}</p>}
          <form method="post" action="#challenge">
            <input type="hidden" name="publication" value={page.publication.id} />
            <label>{w.challenge.text}<textarea name="text" required minlength="20" maxlength="4000" rows="4"></textarea></label>
            <label>{w.challenge.source}<input name="source_url" type="url" maxlength="500" dir="ltr" /></label>
            <label aria-hidden="true" style="position: absolute; inset-inline-start: -9999px">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
            <button>{w.challenge.send}</button>
          </form>
        </section>
      </>
    )}
    {page.kind === "challenge" && (
      <>
        <h1>{w.challenge.status}</h1>
        <p><strong>{w.challenge.keep}</strong></p>
        {page.challenge.publication.path && (
          <p><a href={page.url(page.challenge.publication.path)}>{page.challenge.publication.title ?? page.challenge.publication.path}</a></p>
        )}
        <blockquote>{page.challenge.readerText}</blockquote>
        <dl>
          <dt>{w.challenge.received}</dt><dd>{date(page.challenge.createdAt)}</dd>
          {page.challenge.acknowledgedAt ? (
            <><dt>{w.challenge.acknowledged}</dt><dd>{date(page.challenge.acknowledgedAt)}{page.challenge.acknowledgement && <p>{page.challenge.acknowledgement}</p>}</dd></>
          ) : (
            <><dt>{w.challenge.acknowledgeBy}</dt><dd>{date(page.challenge.acknowledgeBy)}</dd></>
          )}
          {page.challenge.answeredAt ? (
            <><dt>{w.challenge.answered}</dt><dd>{date(page.challenge.answeredAt)}<p>{page.challenge.outcome === "upheld" ? w.challenge.upheld : w.challenge.rejected}</p><p>{page.challenge.answer}</p></dd></>
          ) : (
            <><dt>{w.challenge.answerBy}</dt><dd>{date(page.challenge.answerBy)}</dd></>
          )}
        </dl>
        {page.challenge.outcome === "upheld" && <p><a href={page.links.corrections}>{w.corrections}</a></p>}
      </>
    )}
    {(page.kind === "home" || page.kind === "search") && (
      <>
        <h1>{page.kind === "home" ? w.latest : w.search}</h1>
        {page.pieces.length === 0 ? (
          <p>{page.kind === "home" ? w.nothingYet : page.query ? w.noResults : ""}</p>
        ) : (
          <ul>
            {page.pieces.map((p) => (
              <li><a href={page.url(p.path)}>{p.title ?? p.path}</a> · <time datetime={p.publishedAt.toISOString()}>{date(p.publishedAt)}</time></li>
            ))}
          </ul>
        )}
      </>
    )}
    {page.kind === "ai-policy" && (
      <>
        <h1>{w.aiPolicy}</h1>
        {w.aiPolicyBody({ newsroom: name, editor: page.newsroom.editorInChief }).map((s) => (
          <section id={s.id}>
            <h2>{s.heading}</h2>
            <p>{s.text}</p>
          </section>
        ))}
      </>
    )}
    {page.kind === "corrections" && (
      <>
        <h1>{w.corrections}</h1>
        <p>{w.correctionsBody({ owner: page.newsroom.correctionsOwner })}</p>
        {page.corrections.length === 0 ? <p>{w.correctionsNone}</p> : (
          <ul>
            {page.corrections.map((c) => (
              <li id={c.id}><a href={page.url(c.path)}>{c.title ?? c.path}</a> ({date(c.published_at)}): {c.notice}</li>
            ))}
          </ul>
        )}
      </>
    )}
    {page.kind === "not-found" && <h1>{w.notFound}</h1>}
  </main>
  <footer>
    <a href={page.links.aiPolicy}>{w.aiPolicy}</a>
    <a href={page.links.corrections}>{w.corrections}</a>
  </footer>
</Base>
