---
// A paper's page: its facts, its summary in sections, excerpts, related papers and links. Imported
// text carries its label beside the AI disclosure (D164).
import { directionOf } from "@anr/core";
import type { Page } from "../../lib/page.ts";
import {
  type DatePrecision,
  dateLabel,
  entryPath,
  excerpts,
  links,
  numberLabel,
  refs,
  str,
  strings,
  sectionsIn,
  textHtml,
  textIn,
} from "../../lib/reference.ts";
import Labels from "./Labels.astro";

interface Props {
  page: Extract<Page, { kind: "reference-paper" }>;
}
const { page } = Astro.props;
const { ref: w, language, entry: e } = page;
const f = e.facts;
const text = textIn(e, language);
const lang = text?.language ?? language;
const dir = directionOf(lang);
const precision = (str(f.date_precision) ?? "day") as DatePrecision;
const authors = strings(f.authors);
const affiliations = strings(f.affiliations);
const citations =
  f.citations && typeof f.citations === "object" ? (f.citations as Record<string, unknown>) : null;
const citeSource = str(citations?.source)?.match(/Semantic Scholar|OpenAlex|CrossRef/i)?.[0] ?? "Semantic Scholar";
const citeSourceLabel = language === "fa" && /semantic/i.test(citeSource) ? "سمنتیک اسکالر" : citeSource;
// Each section in the page's language, or in Persian until it is translated (D169).
const sections = sectionsIn(e, language, ["overview", "problem", "idea", "why", "story", "after", "post"]);
const untranslated = sections.some((s) => s.language !== language);
const quotes = excerpts(text?.body.excerpts);
const related = [
  { key: "references", label: w.references, refs: refs(f.references) },
  { key: "cited-by", label: w.citedBy, refs: refs(f.cited_by) },
].filter((g) => g.refs.length > 0);
const sources = links(f.sources);
const telegram = strings(f.telegram);
const url = str(f.url);
---
<div class="ref-page">
  <article>
    <p class="ref-eyebrow">
      <a href={page.links.classics}>{f.classic ? w.classicLabel : w.reference}</a>
      {str(f.arxiv_id) && <> · <bdi dir="ltr">arXiv:{str(f.arxiv_id)}</bdi></>}
    </p>
    <h1 class="ref-title" dir="ltr" lang={e.titleLanguage}>{url ? <a href={url} rel="noopener">{e.title}</a> : e.title}</h1>
    <Labels label={page.label} aiPolicy={page.links.aiPolicy} imported={e.origin === "imported" ? w.imported : null} />
    <dl class="ref-facts">
      {e.date && <><dt>{w.facts.date}</dt><dd><time datetime={e.date}>{dateLabel(e.date, language, precision)}</time></dd></>}
      {authors.length > 0 && <><dt>{w.facts.authors}</dt><dd><bdi dir="ltr" class="ref-latin">{authors.join(", ")}</bdi></dd></>}
      {str(f.venue) && <><dt>{w.facts.venue}</dt><dd><bdi dir="ltr" class="ref-latin">{str(f.venue)}</bdi></dd></>}
      {citations && typeof citations.count === "number" && (
        <><dt>{w.facts.citationsLabel}</dt><dd>{w.facts.citations(new Intl.NumberFormat(language).format(citations.count), citeSourceLabel, str(citations.as_of) ? dateLabel(str(citations.as_of), language) : "")}</dd></>
      )}
      {affiliations.length > 0 && <><dt>{w.facts.affiliations}</dt><dd><bdi dir="ltr" class="ref-latin">{affiliations.join("; ")}</bdi></dd></>}
    </dl>

    {untranslated && <p class="ref-muted">{w.inPersian}</p>}
    {sections.length > 0 && (
      <section>
        <h2>{w.summaryHeading}</h2>
        {sections.map((s) => (
          <div class="ref-panel" data-section={s.name}>
            <h3>{w.sections[s.name]}</h3>
            <div lang={s.language} dir={directionOf(s.language)} set:html={textHtml(s.text)} />
          </div>
        ))}
      </section>
    )}

    {quotes.length > 0 && (
      <section lang={lang} dir={dir}>
        <h2>{w.excerpts}</h2>
        {quotes.map((q) => (
          <div class="ref-panel" data-section="excerpt">
            {q.location && <h3><bdi dir="ltr">{q.location}</bdi></h3>}
            <blockquote dir="ltr" lang="en">{q.original}</blockquote>
            {q.translation && <p>{q.translation}</p>}
            {q.note && <p class="ref-muted">{q.note}</p>}
          </div>
        ))}
      </section>
    )}

    {related.length > 0 && (
      <section>
        <h2>{w.relatedPapers}</h2>
        {related.map((g) => (
          <div class="ref-panel" data-section={g.key}>
            <h3>{g.label}</h3>
            <ul>
              {g.refs.map((r) => (
                <li>
                  {r.entry ? <a href={page.url(entryPath(r.entry.kind, r.entry.slug))}><bdi dir="ltr" lang="en">{r.title}</bdi></a>
                    : r.url ? <a href={r.url} rel="noopener"><bdi dir="ltr" lang="en">{r.title}</bdi></a>
                    : <bdi dir="ltr" lang="en">{r.title}</bdi>}
                  {r.year && <span class="ref-muted"> ({numberLabel(r.year, language)})</span>}
                  {(language === "fa" ? r.note : (r.noteEn ?? r.note)) && (
                    <span class="ref-muted" dir="auto"> {language === "fa" ? r.note : (r.noteEn ?? r.note)}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}

    <nav class="ref-pager" aria-label={w.classics}>
      {page.newer ? <a href={page.url(entryPath("paper", page.newer.slug))}><span>{w.newer}</span><bdi dir="ltr" lang="en">{page.newer.title}</bdi></a> : <span />}
      {page.older ? <a href={page.url(entryPath("paper", page.older.slug))}><span>{w.older}</span><bdi dir="ltr" lang="en">{page.older.title}</bdi></a> : <span />}
    </nav>
  </article>

  <aside class="ref-side">
    {sources.length > 0 && (
      <>
        <h2>{w.sources}</h2>
        <ul dir="ltr" lang="en">{sources.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}</ul>
      </>
    )}
    {url && sources.length === 0 && (
      <>
        <h2>{w.links}</h2>
        <ul><li><a href={url} rel="noopener" dir="ltr">{url}</a></li></ul>
      </>
    )}
    {telegram.length > 0 && (
      <>
        <h2>{w.onTelegram}</h2>
        <ul>{telegram.map((t) => <li><a href={t} rel="noopener">{w.telegramPost(numberLabel(Number(t.split("/").pop()), language))}</a></li>)}</ul>
      </>
    )}
  </aside>
</div>
