---
// What in the Reference points at an entry, grouped by kind (D170): timeline items as on their
// timeline, documents as tiles, profiles as links.
import type { Language } from "@anr/core";
import { type Entry, entryName, linkedOrNull, type OutLink } from "../../lib/reference.ts";
import { nameOf, type ReferenceConfig } from "../../lib/reference-config.ts";
import type { Incoming } from "../../lib/reference-page.ts";
import type { ReferenceWords } from "../../lib/reference-words.ts";
import DocumentTile from "./DocumentTile.astro";
import TimelineItem from "./TimelineItem.astro";

interface Props {
  groups: Incoming[];
  links: Map<string, OutLink[]>;
  reference: ReferenceConfig;
  language: Language;
  words: ReferenceWords;
  entryUrl: (kind: string, slug: string) => string | null;
  url: (path: string) => string;
}
const { groups, links, language, words: w, entryUrl, url } = Astro.props;
const filterUrl = (path: string) => (fact: string, value: string) =>
  `${url(`/reference/${path}`)}?${fact}=${encodeURIComponent(value)}`;
const href = (e: Entry) => entryUrl(e.kind, e.slug) ?? "#";
---
{groups.length > 0 && (
  <section>
    <h2>{w.linkedFrom}</h2>
    {groups.map((g) => (
      <section class="ref-group">
        <h3>{nameOf(g.kind.name, language)} <span class="ref-muted">{g.entries.length}</span></h3>
        {g.kind.layout === "timeline" ? (
          <ol class="ref-list">
            {g.entries.map((e) => (
              <TimelineItem entry={e} language={language} words={w} kind={g.kind} outLinks={linkedOrNull(links, e.id)} entryUrl={entryUrl} filterUrl={filterUrl(g.kind.path)} />
            ))}
          </ol>
        ) : g.kind.layout === "document" ? (
          <ul class="ref-tiles">
            {g.entries.map((e) => <DocumentTile entry={e} language={language} kind={g.kind} label={nameOf(g.kind.one, language)} href={href(e)} />)}
          </ul>
        ) : (
          <ul>{g.entries.map((e) => <li><a href={href(e)} dir="auto">{entryName(e, language)}</a></li>)}</ul>
        )}
      </section>
    ))}
  </section>
)}
