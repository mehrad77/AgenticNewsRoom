---
// What in the Reference points at an entry, grouped by kind (D170): timeline items as on their
// timeline, documents as tiles, profiles as links. A long group shows its first few and keeps the
// rest behind "Show all"; with several groups, links at the top jump to each.
import type { Language } from "@anr/core";
import type { EntryImage, OutLink } from "../../lib/reference.ts";
import { nameOf, type ReferenceConfig } from "../../lib/reference-config.ts";
import type { Incoming } from "../../lib/reference-page.ts";
import type { ReferenceWords } from "../../lib/reference-words.ts";
import IncomingList from "./IncomingList.astro";

interface Props {
  groups: Incoming[];
  links: Map<string, OutLink[]>;
  targetImages: Map<string, EntryImage>;
  reference: ReferenceConfig;
  language: Language;
  words: ReferenceWords;
  entryUrl: (kind: string, slug: string) => string | null;
  url: (path: string) => string;
}
const { groups, links, targetImages, language, words: w, entryUrl, url } = Astro.props;
const count = (n: number) => new Intl.NumberFormat(language).format(n);
// How many of a group show before "Show all", by layout.
const SHOWN: Record<string, number> = { timeline: 5, document: 6 };
const shown = (g: Incoming) => SHOWN[g.kind.layout ?? ""] ?? 12;
const id = (g: Incoming) => `in-${g.kindKey}`;
const list = { links, targetImages, language, words: w, entryUrl, url };
---
{groups.length > 0 && (
  <section>
    <h2>{w.linkedFrom}</h2>
    {groups.length > 1 && (
      <nav class="ref-jump" aria-label={w.linkedFrom}>
        {groups.map((g) => <a href={`#${id(g)}`}>{nameOf(g.kind.name, language)} <span class="ref-muted">{count(g.entries.length)}</span></a>)}
      </nav>
    )}
    {groups.map((g) => (
      <section class="ref-group" id={id(g)}>
        <h3>{nameOf(g.kind.name, language)} <span class="ref-muted">{count(g.entries.length)}</span></h3>
        <IncomingList group={g} entries={g.entries.slice(0, shown(g))} {...list} />
        {g.entries.length > shown(g) && (
          <details class="ref-more">
            <summary><span class="ref-more-closed">{w.showAll(count(g.entries.length))}</span><span class="ref-more-open">{w.showFewer}</span></summary>
            <IncomingList group={g} entries={g.entries.slice(shown(g))} {...list} />
          </details>
        )}
      </section>
    ))}
  </section>
)}
