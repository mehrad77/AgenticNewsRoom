---
// The lab news timeline: years, then days, newest first, with filters by lab and kind (a plain
// GET form, so it works without scripts).
import type { Page } from "../../lib/page.ts";
import { dateLabel, groupBy, nameIn, numberLabel, strings } from "../../lib/reference.ts";
import NewsItem from "./NewsItem.astro";
import Labels from "./Labels.astro";

interface Props {
  page: Extract<Page, { kind: "reference-news" }>;
}
const { page } = Astro.props;
const { ref: w, language, news, filters } = page;
const n = (x: number) => numberLabel(x, language);
const years = groupBy(news, (e) => (e.date ?? "").slice(0, 4)).map((y) => ({
  ...y,
  days: groupBy(y.entries, (e) => e.date ?? ""),
}));
const kindUrl = (k: string) => `${page.links.news}?kind=${encodeURIComponent(k)}`;
const orgName = (org: string) => {
  const sample = news.find((e) => e.facts.org === org) ?? null;
  return sample ? (nameIn(sample.facts, "org", language) ?? org) : org;
};
const posted = news.filter((e) => strings(e.facts.telegram).length > 0).length;
const oldest = news[news.length - 1];
const newest = news[0];
const filtered = !!(filters.org || filters.kind);
---
<h1>{w.news}</h1>
<p class="ref-lead">{w.newsIntro}</p>
<Labels label={page.label} aiPolicy={page.links.aiPolicy} imported={w.imported} />
<div class="ref-stats">
  <div class="ref-stat"><b>{n(news.length)}</b><span>{w.news}</span></div>
  <div class="ref-stat"><b>{n(posted)}</b><span>{w.onTelegram}</span></div>
  {oldest && newest && (
    <div class="ref-stat"><b>{dateLabel(oldest.date, language, "year")}</b><span>{w.oldest(dateLabel(newest.date, language))}</span></div>
  )}
</div>
<form class="ref-filters" method="get" action={page.links.news}>
  <label>{w.orgLabel}
    <select name="org">
      <option value="">{w.allOrgs}</option>
      {filters.orgs.map((o) => <option value={o.value} selected={o.value === filters.org}>{`${orgName(o.value)} (${n(o.count)})`}</option>)}
    </select>
  </label>
  <label>{w.kindLabel}
    <select name="kind">
      <option value="">{w.allKinds}</option>
      {filters.kinds.map((k) => <option value={k.value} selected={k.value === filters.kind}>{`${w.newsKinds[k.value] ?? k.value} (${n(k.count)})`}</option>)}
    </select>
  </label>
  <button>{w.filter}</button>
  {filtered && <a href={page.links.news}>{w.clear}</a>}
</form>
<nav class="ref-jump" aria-label={w.news}>
  {years.map((y) => <a href={`#y-${y.key}`}>{dateLabel(`${y.key}-01-01`, language, "year")}</a>)}
</nav>
{news.length === 0 && <p>{w.nothing}</p>}
{years.map((y) => (
  <section class="ref-group" id={`y-${y.key}`}>
    <h2>{dateLabel(`${y.key}-01-01`, language, "year")} <span class="ref-muted">{w.newsCount(n(y.entries.length))}</span></h2>
    {y.days.map((d) => (
      <section class="ref-day">
        <h3><time datetime={d.key}>{dateLabel(d.key, language)}</time></h3>
        <ol class="ref-list">
          {d.entries.map((e) => <NewsItem entry={e} language={language} words={w} kindUrl={kindUrl} />)}
        </ol>
      </section>
    ))}
  </section>
))}
