---
// One news event on the timeline or the Reference's home: its date, lab, kind, official link and
// summary, as the old archive showed it.
import { directionOf, type Language } from "@anr/core";
import {
  dateLabel,
  type Entry,
  links,
  nameIn,
  numberLabel,
  str,
  strings,
  textIn,
} from "../../lib/reference.ts";
import type { ReferenceWords } from "../../lib/reference-words.ts";

interface Props {
  entry: Entry;
  language: Language;
  words: ReferenceWords;
  kindUrl: (kind: string) => string;
}
const { entry: e, language, words: w, kindUrl } = Astro.props;
const f = e.facts;
const kind = str(f.news_kind) ?? "other";
const url = str(f.url);
const text = textIn(e, language);
const org = nameIn(f, "org", language);
const urlType = str(f.url_type) ?? "official";
const telegram = strings(f.telegram);
const entities = strings(f.entities).filter((n) => n !== str(f.org));
---
<li class="ref-news" id={e.slug}>
  <div class="ref-meta">
    <time datetime={e.date}>{dateLabel(e.date, language)}</time>
    {e.dateStatus === "approximate" && <span>{w.approximate}</span>}
    {org && <><span aria-hidden="true">·</span><b>{org}</b></>}
    <a class="ref-chip" href={kindUrl(kind)}>{w.newsKinds[kind] ?? kind}</a>
  </div>
  <h4 dir="ltr" lang={e.titleLanguage}>{url ? <a href={url} rel="noopener">{e.title}</a> : e.title}</h4>
  {text && <p lang={text.language} dir={directionOf(text.language)}>{str(text.body.summary)}</p>}
  {entities.length > 0 && (
    <p class="ref-meta">{w.related}: {entities.map((n) => <span class="ref-chip" dir="auto">{n}</span>)}</p>
  )}
  <div class="ref-links">
    {url && <a href={url} rel="noopener">{w.urlTypes[urlType] ?? w.urlTypes.other}</a>}
    {links(f.links).map((l) => <a href={l.url} rel="noopener" dir="auto">{l.label}</a>)}
    {telegram.map((t) => <a href={t} rel="noopener">{w.telegramPost(numberLabel(Number(t.split("/").pop()), language))}</a>)}
  </div>
</li>
