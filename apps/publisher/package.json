{
  "name": "@anr/publisher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./publish": "./src/publish.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/worker.ts",
    "start": "node --env-file-if-exists=../../.env src/worker.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "cues": "node scripts/cues.ts",
    "samples": "node scripts/listening-samples.ts"
  },
  "dependencies": {
    "@anr/core": "workspace:*",
    "@anr/db": "workspace:*",
    "@anr/models": "workspace:*",
    "@anr/render": "workspace:*",
    "pg-boss": "12.38.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
