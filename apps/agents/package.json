{
  "name": "@anr/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import @anr/telemetry/register --watch src/worker.ts",
    "start": "node --env-file-if-exists=../../.env --import @anr/telemetry/register src/worker.ts",
    "recheck": "node --env-file-if-exists=../../.env src/recheck/cli.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anr/config": "workspace:*",
    "@anr/core": "workspace:*",
    "@anr/db": "workspace:*",
    "@anr/models": "workspace:*",
    "@anr/render": "workspace:*",
    "@anr/schemas": "workspace:*",
    "@anr/telemetry": "workspace:*",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@opentelemetry/api": "1.10.0",
    "pg-boss": "12.38.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
