{
  "name": "@anr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/generated/api.ts",
    "./mcp-tools": "./src/generated/mcp-tools.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import @anr/telemetry/register --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import @anr/telemetry/register src/server.ts",
    "gen": "openapi-typescript openapi.yaml -o src/generated/api.ts && node scripts/gen-mcp.ts",
    "lint": "redocly lint openapi.yaml",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "desk:grant": "node scripts/grant.ts",
    "dev:test": "node scripts/dev-test.ts",
    "desk:admin": "node scripts/admin.ts"
  },
  "dependencies": {
    "@anr/config": "workspace:*",
    "@anr/core": "workspace:*",
    "@anr/db": "workspace:*",
    "@anr/models": "workspace:*",
    "@anr/render": "workspace:*",
    "@anr/schemas": "workspace:*",
    "@anr/telemetry": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@anr/publisher": "workspace:*",
    "@redocly/cli": "2.72.1",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
