{
  "name": "@anr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/generated/api.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "gen": "openapi-typescript openapi.yaml -o src/generated/api.ts",
    "lint": "redocly lint openapi.yaml",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "desk:grant": "node scripts/grant.ts",
    "dev:test": "node scripts/dev-test.ts",
    "desk:admin": "node scripts/admin.ts"
  },
  "dependencies": {
    "@anr/core": "workspace:*",
    "@anr/db": "workspace:*",
    "@anr/models": "workspace:*",
    "@anr/render": "workspace:*",
    "@anr/schemas": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "jose": "6.2.12",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@anr/publisher": "workspace:*",
    "@redocly/cli": "2.71.0",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
