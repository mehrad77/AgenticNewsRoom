{
  "name": "@anr/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "uv run --frozen ruff check python && uv run --frozen ruff format --check python",
    "typecheck": "tsc -p . && uv run --frozen mypy python/anr_telemetry",
    "test": "vitest run",
    "gen": "node ops/gen.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.1",
    "@opentelemetry/instrumentation": "0.301.1",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "import-in-the-middle": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
