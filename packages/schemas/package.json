{
  "name": "@anr/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./json/*": "./json/*",
    "./iptc/*": "./iptc/*"
  },
  "scripts": {
    "gen": "node scripts/gen.ts && uv run --frozen python scripts/gen_py.py",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "iptc": "node scripts/iptc.ts",
    "view": "node viewer/server.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.5",
    "@types/node": "24.19.2",
    "json-schema-to-zod": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
