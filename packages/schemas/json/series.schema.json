{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anr.local/schemas/series.schema.json",
  "title": "SeriesConfig",
  "description": "config/newsrooms/<slug>/series/<series>.yaml: a named recurring output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "languages", "cadence", "channels"],
  "properties": {
    "name": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": ["fa", "en", "tr"]
      }
    },
    "format": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["fa", "en", "tr"]
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "daily": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "weekly": {
          "type": "string",
          "pattern": "^(mon|tue|wed|thu|fri|sat|sun) [0-2][0-9]:[0-5][0-9]$"
        }
      }
    },
    "assignment_at": {
      "type": "string",
      "description": "When code makes the assignment for the next slot: a time (daily series) or a weekday and time (weekly series built from segments).",
      "pattern": "^((mon|tue|wed|thu|fri|sat|sun) )?[0-2][0-9]:[0-5][0-9]$"
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+-[0-9]+$"
      }
    },
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner_proposes", "by", "editor_picks_by"],
      "properties": {
        "planner_proposes": {
          "type": "integer",
          "const": 3
        },
        "by": {
          "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
        },
        "editor_picks_by": {
          "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
        },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fact"],
          "description": "The Reference entries the planner proposes from (D175): those of `kind` whose boolean `fact` is true and that no published piece covers yet.",
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "fact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "minutes", "from"],
        "properties": {
          "kind": {
            "enum": ["news-recap", "story"]
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "from": {
            "type": "string",
            "pattern": "^week\\.[a-z0-9-]+$"
          }
        }
      }
    },
    "hosts": {
      "type": "object",
      "description": "Per language: host name -> TTS voice.",
      "propertyNames": {
        "enum": ["fa", "en", "tr"]
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "host_names": {
      "type": "object",
      "description": "Per language: host -> the name as spoken and written in that language. Required for right-to-left languages; otherwise the host's key, capitalised.",
      "propertyNames": {
        "enum": ["fa", "en", "tr"]
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "channels": {
      "type": "object",
      "description": "Channel kind -> languages. The publisher finds matching channels (data) at send time.",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["site", "telegram", "podcast-rss"]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": ["fa", "en", "tr"]
        }
      }
    },
    "narrator": {
      "type": "object",
      "description": "Per language: the narrator's TTS voice, used by story segments.",
      "propertyNames": {
        "enum": ["fa", "en", "tr"]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "engine_voices": {
      "type": "object",
      "description": "Per text-to-speech engine (a catalogue id), per language: a voice for each host and \"narrator\". `hosts` and `narrator` are the default engine's voices; a local engine without voices here gives each speaker its own default (D113).",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "enum": ["fa", "en", "tr"]
        },
        "additionalProperties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name"],
      "description": "The series' news items as a timeline on the site at /<path>, newest first (D173).",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "enum": ["fa", "en", "tr"]
          }
        },
        "intro": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "enum": ["fa", "en", "tr"]
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact", "name"],
            "properties": {
              "fact": {
                "enum": ["org", "news_kind"]
              },
              "name": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "propertyNames": {
                  "enum": ["fa", "en", "tr"]
                }
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  },
                  "propertyNames": {
                    "enum": ["fa", "en", "tr"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "description": "The series' page at /<series>, listing its pieces newest first, and its link in the site's header (D179).",
      "properties": {
        "name": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "enum": ["fa", "en", "tr"]
          }
        },
        "intro": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "enum": ["fa", "en", "tr"]
          }
        }
      }
    }
  }
}
