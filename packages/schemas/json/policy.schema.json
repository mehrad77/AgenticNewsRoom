{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anr.local/schemas/policy.schema.json",
  "title": "PolicyConfig",
  "description": "config/newsrooms/<slug>/policy.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["beats", "sources", "auto_publish"],
  "properties": {
    "beats": {
      "type": "object",
      "minProperties": 1,
      "description": "Beat name -> status and the IPTC Media Topics that classify it.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "media_topics"],
        "properties": {
          "status": {
            "enum": ["open", "restricted", "banned"]
          },
          "media_topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "IPTC Media Topic qcodes (packages/schemas/iptc/mediatopic.json); not retired.",
            "items": {
              "type": "string",
              "pattern": "^medtop:[0-9]{8}$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What the beat covers, in one line; the summariser reads it to place leads in beats."
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_independent", "tier1_alone"],
      "properties": {
        "min_independent": {
          "type": "integer",
          "minimum": 2
        },
        "tier1_alone": {
          "type": "boolean"
        }
      }
    },
    "leads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_age_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Scheduled runs store no item older than this by its newest date, and no undated item."
        }
      }
    },
    "papers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiers", "newsletter_min"],
      "properties": {
        "tiers": {
          "type": "array",
          "items": {
            "enum": ["flagged", "high", "medium", "low"]
          }
        },
        "newsletter_min": {
          "enum": ["high", "medium", "low"]
        },
        "high_venues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Venues whose papers are high (tier 1), matched case-insensitively against the venue Semantic Scholar reports, never the authors' own comment."
        },
        "high_citations": {
          "type": "integer",
          "minimum": 1,
          "description": "Citations, as Semantic Scholar counts them, that make a paper high (tier 1)."
        }
      }
    },
    "auto_publish": {
      "type": "array",
      "description": "Formats that publish as daily news without an editor when no check holds them.",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "opinion": {
      "enum": ["not_allowed", "allowed_marked"],
      "default": "not_allowed"
    }
  }
}
