{
  "description": "Shared test vectors for text normalisation. The verifier (Python) and the SQL function anr.normalize_text() must both map each input to its expected output. Case folding depends on the text's language.",
  "cases": [
    {
      "name": "arabic ye to persian ye",
      "input": "علي",
      "expected": "علی",
      "language": "fa"
    },
    {
      "name": "arabic kaf to persian kaf",
      "input": "كتاب",
      "expected": "کتاب",
      "language": "fa"
    },
    {
      "name": "zero-width non-joiner removed",
      "input": "می‌شود",
      "expected": "میشود",
      "language": "fa"
    },
    {
      "name": "persian digits to latin",
      "input": "۱۴۰۵",
      "expected": "1405",
      "language": "fa"
    },
    {
      "name": "turkish dotted capital I",
      "input": "İSTANBUL",
      "expected": "istanbul",
      "language": "tr"
    },
    {
      "name": "turkish dotless capital I",
      "input": "IRMAK",
      "expected": "ırmak",
      "language": "tr"
    },
    {
      "name": "nfkc compatibility forms",
      "input": "ﬁle",
      "expected": "file",
      "language": "en"
    },
    {
      "name": "arabic alef maksura to persian ye",
      "input": "موسى",
      "expected": "موسی",
      "language": "fa"
    },
    {
      "name": "arabic-indic digits to latin",
      "input": "٢٠٢٦",
      "expected": "2026",
      "language": "fa"
    },
    {
      "name": "arabic presentation forms folded by nfkc, then kaf mapped",
      "input": "ﻙﺘﺎﺏ",
      "expected": "کتاب",
      "language": "fa"
    },
    {
      "name": "lower case outside turkish",
      "input": "OpenAI GPT",
      "expected": "openai gpt",
      "language": "en"
    },
    {
      "name": "dotted capital I outside turkish keeps its dot as a combining mark",
      "input": "İstanbul",
      "expected": "i̇stanbul",
      "language": "en"
    },
    {
      "name": "no language uses the default rules",
      "input": "IRMAK",
      "expected": "irmak",
      "language": null
    }
  ]
}
