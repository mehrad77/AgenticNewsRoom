{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["WEB_PORT"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^gen"]
    },
    "test": {
      "dependsOn": ["^gen"]
    },
    "gen": {
      "cache": false
    }
  }
}
