<article lang="{{ language }}" dir="{{ direction }}">
  <h1>{{ rendition.title }}</h1>
  <p class="anr-disclosure"><a href="{{ ai_policy_url }}">{% render "disclosure", language: language, edited: edited %}</a></p>
  {% for item in rendition.items %}
    <section{% if item.opinion %} class="anr-opinion"{% endif %}>
      {% if item.heading %}<h2>{{ item.heading }}</h2>{% endif %}
      {% if item.opinion %}<p class="anr-opinion-label">{{ labels.opinion }}</p>{% endif %}
      {% for p in item.paragraphs %}<p>{{ p }}</p>{% endfor %}
    </section>
  {% endfor %}
</article>
