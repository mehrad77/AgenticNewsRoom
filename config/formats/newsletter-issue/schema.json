{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anr.local/formats/newsletter-issue/schema.json",
  "title": "NewsletterIssueDraft",
  "description": "Newsletter issue: the day's news items plus up to two outside articles worth reading. A desk submit carries the story and its first rendition; a renderer submit carries only a rendition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rendition"],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "lead_id", "quoted_passage"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c[0-9]+$"
        },
        "kind": {
          "enum": ["fact", "quote", "opinion"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "lead_id": {
          "type": "string",
          "minLength": 1,
          "description": "A stored lead in this newsroom."
        },
        "quoted_passage": {
          "type": "string",
          "description": "Exact passage from the lead's stored text."
        },
        "also": {
          "type": "array",
          "maxItems": 4,
          "description": "Further leads that support the same claim, each with its own passage; independence is counted over these and lead_id (D74).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lead_id", "quoted_passage"],
            "properties": {
              "lead_id": {
                "type": "string",
                "minLength": 1
              },
              "quoted_passage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^c[0-9]+$"
      }
    }
  },
  "properties": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "beat", "claims"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "beat": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "rendition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "title", "items"],
      "properties": {
        "language": {
          "enum": ["fa", "en", "tr"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "headline", "body", "claim_ids"],
                "properties": {
                  "kind": {
                    "const": "news"
                  },
                  "headline": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "claim_ids": {
                    "$ref": "#/$defs/claim_ids"
                  },
                  "org": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Who the item is about (the lab, company or institute), as its source names it. The site links it to the Reference entry of that name (D173)."
                  },
                  "news_kind": {
                    "enum": [
                      "model",
                      "product",
                      "tool",
                      "research-blog",
                      "open-source",
                      "funding",
                      "org",
                      "other"
                    ],
                    "description": "What kind of news it is, for the timeline's filter (D173)."
                  },
                  "related": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Products, models, people or organisations the item names, as it names them."
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Set by code: the item's own page. The site otherwise links its first claim's lead."
                  },
                  "url_type": {
                    "enum": ["official", "docs", "repo", "press", "wikipedia", "other"],
                    "description": "Set by code: what kind of page `url` is."
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["url", "label"],
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "Set by code: further links the item carries."
                  },
                  "anchor": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "description": "Set by code: the item's id on the timeline."
                  },
                  "approximate": {
                    "type": "boolean",
                    "description": "Set by code: the item's date is approximate."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "lead_id", "reason", "claim_ids"],
                "properties": {
                  "kind": {
                    "const": "article"
                  },
                  "title": {
                    "type": "string"
                  },
                  "lead_id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "description": "One line: why it is worth reading."
                  },
                  "claim_ids": {
                    "$ref": "#/$defs/claim_ids"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
