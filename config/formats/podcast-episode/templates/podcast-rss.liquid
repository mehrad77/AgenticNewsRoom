<item>
  <title>{{ rendition.title }}</title>
  <link>{{ site_url }}</link>
  <description><![CDATA[{{ show_notes }}

{% render "disclosure", language: language, edited: edited %}]]></description>
  <enclosure url="{{ audio_url }}" length="{{ audio_bytes }}" type="audio/mpeg"/>
  <guid isPermaLink="false">{{ publication_id }}-{{ language }}</guid>
  <pubDate>{{ published_at }}</pubDate>
  <itunes:duration>{{ audio_seconds }}</itunes:duration>
</item>
