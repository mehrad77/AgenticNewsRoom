{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anr.local/formats/podcast-episode/schema.json",
  "title": "PodcastEpisodeDraft",
  "description": "Podcast episode script: news-recap segments of host lines, and story segments told as a narrative arc with protagonists, a narrator, delivery directions and sound cues. Code makes the audio. A desk submit carries the story and its first rendition; a renderer submit carries only a rendition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rendition"],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "lead_id", "quoted_passage"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c[0-9]+$"
        },
        "kind": {
          "enum": ["fact", "quote", "opinion"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "lead_id": {
          "type": "string",
          "minLength": 1,
          "description": "A stored lead in this newsroom."
        },
        "quoted_passage": {
          "type": "string",
          "description": "Exact passage from the lead's stored text."
        },
        "also": {
          "type": "array",
          "maxItems": 4,
          "description": "Further leads that support the same claim, each with its own passage; independence is counted over these and lead_id (D74).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lead_id", "quoted_passage"],
            "properties": {
              "lead_id": {
                "type": "string",
                "minLength": 1
              },
              "quoted_passage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^c[0-9]+$"
      }
    },
    "host_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "text", "claim_ids"],
      "properties": {
        "host": {
          "type": "string",
          "description": "A host of the series for this language."
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "$ref": "#/$defs/claim_ids"
        }
      }
    },
    "story_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "text", "claim_ids"],
      "properties": {
        "speaker": {
          "type": "string",
          "description": "A host of the series for this language, or \"narrator\"."
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "maxLength": 40,
          "description": "Delivery hint passed to TTS as a style prompt, e.g. \"hushed\", \"curious, slower\"."
        },
        "claim_ids": {
          "$ref": "#/$defs/claim_ids"
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue"],
      "properties": {
        "cue": {
          "enum": ["sting", "bed-swell", "bed-out", "pause", "transition"],
          "description": "Mapped by the audio mix to the series' stock assets. Never recorded music."
        },
        "seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5,
          "description": "Only for pause."
        }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat", "lines"],
      "properties": {
        "beat": {
          "enum": ["cold-open", "context", "turning-point", "stakes", "resolution", "takeaway"]
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/story_line"
              },
              {
                "$ref": "#/$defs/cue"
              }
            ]
          }
        }
      }
    },
    "protagonist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "claim_ids"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Who they are in this story, e.g. \"first author\", \"the band's drummer\"."
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "description": "Claims that establish who they are."
        }
      }
    }
  },
  "properties": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "beat", "claims"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "beat": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "rendition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "title", "items"],
      "properties": {
        "language": {
          "enum": ["fa", "en", "tr"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["segment", "lines"],
                "properties": {
                  "segment": {
                    "const": "news-recap"
                  },
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/host_line"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["segment", "protagonists", "beats"],
                "description": "A story told as a narrative: protagonists and an arc of beats.",
                "properties": {
                  "segment": {
                    "const": "story"
                  },
                  "protagonists": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "$ref": "#/$defs/protagonist"
                    }
                  },
                  "beats": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                      "$ref": "#/$defs/beat"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
