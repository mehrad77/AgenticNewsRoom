{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@anr/web", "dev"],
      "port": 4321
    },
    {
      "name": "web-test",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@anr/web", "dev:test"],
      "port": 4410,
      "url": "http://m4preview.localhost:4410"
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@anr/api", "dev"],
      "port": 8787
    },
    {
      "name": "api-test",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@anr/api", "dev:test"],
      "port": 8788
    },
    {
      "name": "schemas",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@anr/schemas", "run", "view"],
      "port": 4400,
      "autoPort": true
    },
    {
      "name": "tts-chatterbox",
      "runtimeExecutable": "tools/tts-eval/.venv-chatterbox/bin/python",
      "runtimeArgs": ["tools/tts-eval/serve.py", "chatterbox", "--port", "8601"],
      "port": 8601
    },
    {
      "name": "tts-xtts",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "COQUI_TOS_AGREED=1",
        "tools/tts-eval/.venv-xtts/bin/python",
        "tools/tts-eval/serve.py",
        "xtts",
        "--port",
        "8602"
      ],
      "port": 8602
    },
    {
      "name": "tts-dia",
      "runtimeExecutable": "tools/tts-eval/.venv-dia/bin/python",
      "runtimeArgs": ["tools/tts-eval/serve.py", "dia", "--port", "8603"],
      "port": 8603
    },
    {
      "name": "tts-eval",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4430",
        "--bind",
        "127.0.0.1",
        "--directory",
        "tools/tts-eval"
      ],
      "port": 4430,
      "url": "http://localhost:4430"
    }
  ]
}
